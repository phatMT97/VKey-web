---
import {
  CheckCircle2,
  ChevronRight,
  Copy,
  Cpu,
  Download,
  FileText,
  Gamepad2,
  Github,
  Globe2,
  Keyboard,
  Layers,
  Moon,
  RefreshCcw,
  Settings2,
  ShieldCheck,
  Sparkles,
  Sun,
  Terminal,
  Zap,
} from 'lucide-astro';
import '../styles/global.css';

type ReleaseAsset = {
  name: string;
  browser_download_url: string;
};

type GitHubRelease = {
  tag_name: string;
  name: string | null;
  body: string | null;
  html_url: string;
  published_at: string;
  assets: ReleaseAsset[];
};

const githubOwner = import.meta.env.PUBLIC_GITHUB_OWNER ?? 'phatMT97';
const githubRepo = import.meta.env.PUBLIC_GITHUB_REPO ?? 'VKey';
const githubToken = import.meta.env.GITHUB_TOKEN;
const wingetStandardId = import.meta.env.PUBLIC_WINGET_ID ?? 'PhatMT97.VKey';
const wingetClassicId = 'PhatMT97.VKey.Classic';
const releasesUrl = `https://github.com/${githubOwner}/${githubRepo}/releases`;
const repoUrl = `https://github.com/${githubOwner}/${githubRepo}`;
const guideUrl = '/guide';
const autostartGuideUrl = `https://github.com/${githubOwner}/${githubRepo}/blob/master/docs/uninstall-autostart.md`;
const antivirusGuideUrl = `https://github.com/${githubOwner}/${githubRepo}/blob/master/docs/ANTIVIRUS.md`;

async function getLatestRelease(): Promise<GitHubRelease | null> {
  try {
    const headers: Record<string, string> = {
      Accept: 'application/vnd.github+json',
      'X-GitHub-Api-Version': '2022-11-28',
    };

    if (githubToken) {
      headers.Authorization = `Bearer ${githubToken}`;
    }

    const response = await fetch(`https://api.github.com/repos/${githubOwner}/${githubRepo}/releases/latest`, {
      headers,
    });

    if (!response.ok) {
      console.warn(`GitHub Releases API returned ${response.status} ${response.statusText} for ${githubOwner}/${githubRepo}.`);
      return null;
    }

    return await response.json();
  } catch (error) {
    console.warn(`Could not fetch the latest GitHub release for ${githubOwner}/${githubRepo}.`, error);
    return null;
  }
}

function escapeHtml(value: string): string {
  return value
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#39;');
}

function escapeAttribute(value: string): string {
  return escapeHtml(value).replaceAll('`', '&#96;');
}

function isSafeUrl(value: string): boolean {
  try {
    const url = new URL(value);
    return url.protocol === 'https:' || url.protocol === 'http:';
  } catch {
    return false;
  }
}

function renderInlineMarkdown(value: string): string {
  let html = escapeHtml(value.replaceAll('—', ' - ').replaceAll('–', '-'));

  html = html.replace(/\[!\[([^\]]*)\]\((https?:\/\/[^\s)]+)\)\]\((https?:\/\/[^\s)]+)\)/g, (_match, alt: string, imageUrl: string, linkUrl: string) => {
    if (!isSafeUrl(imageUrl) || !isSafeUrl(linkUrl)) return '';
    return `<a href="${escapeAttribute(linkUrl)}" target="_blank" rel="noreferrer"><img src="${escapeAttribute(imageUrl)}" alt="${escapeAttribute(alt)}" loading="lazy" /></a>`;
  });
  html = html.replace(/!\[([^\]]*)\]\((https?:\/\/[^\s)]+)\)/g, (_match, alt: string, imageUrl: string) => {
    if (!isSafeUrl(imageUrl)) return '';
    return `<img src="${escapeAttribute(imageUrl)}" alt="${escapeAttribute(alt)}" loading="lazy" />`;
  });
  html = html.replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g, (_match, label: string, linkUrl: string) => {
    if (!isSafeUrl(linkUrl)) return label;
    return `<a href="${escapeAttribute(linkUrl)}" target="_blank" rel="noreferrer">${label}</a>`;
  });
  html = html.replace(/`([^`]+)`/g, '<code>$1</code>');
  html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');

  return html;
}

function renderReleaseMarkdown(markdown: string): string {
  // Strip leading h1/h2 title if it duplicates the release card header
  const cleanMarkdown = markdown.trim().replace(/^#{1,2}\s+[^\n]+\n*/, '');
  const lines = cleanMarkdown.replace(/\r\n/g, '\n').split('\n');
  const output: string[] = [];
  const paragraph: string[] = [];
  const codeLines: string[] = [];
  let listType: 'ul' | 'ol' | null = null;
  let inCodeBlock = false;
  let codeLanguage = '';

  const closeParagraph = () => {
    if (paragraph.length === 0) return;
    output.push(`<p>${renderInlineMarkdown(paragraph.join(' '))}</p>`);
    paragraph.length = 0;
  };

  const closeList = () => {
    if (!listType) return;
    output.push(`</${listType}>`);
    listType = null;
  };

  const closeCodeBlock = () => {
    const languageClass = codeLanguage ? ` class="language-${escapeAttribute(codeLanguage)}"` : '';
    output.push(`<pre><code${languageClass}>${escapeHtml(codeLines.join('\n'))}</code></pre>`);
    codeLines.length = 0;
    codeLanguage = '';
    inCodeBlock = false;
  };

  for (const rawLine of lines) {
    const line = rawLine.trim();
    const fence = line.match(/^```\s*([\w-]*)\s*$/);

    if (fence) {
      if (inCodeBlock) {
        closeCodeBlock();
      } else {
        closeParagraph();
        closeList();
        inCodeBlock = true;
        codeLanguage = fence[1] ?? '';
      }
      continue;
    }

    if (inCodeBlock) {
      codeLines.push(rawLine);
      continue;
    }

    if (!line) {
      closeParagraph();
      closeList();
      continue;
    }

    const heading = line.match(/^(#{1,6})\s+(.+)$/);
    if (heading) {
      closeParagraph();
      closeList();
      const level = Math.min(heading[1].length + 2, 6);
      output.push(`<h${level}>${renderInlineMarkdown(heading[2])}</h${level}>`);
      continue;
    }

    if (/^---+$/.test(line)) {
      closeParagraph();
      closeList();
      output.push('<hr />');
      continue;
    }

    const unordered = line.match(/^[-*+]\s+(.+)$/);
    if (unordered) {
      closeParagraph();
      if (listType !== 'ul') {
        closeList();
        output.push('<ul>');
        listType = 'ul';
      }
      output.push(`<li>${renderInlineMarkdown(unordered[1])}</li>`);
      continue;
    }

    const ordered = line.match(/^\d+\.\s+(.+)$/);
    if (ordered) {
      closeParagraph();
      if (listType !== 'ol') {
        closeList();
        output.push('<ol>');
        listType = 'ol';
      }
      output.push(`<li>${renderInlineMarkdown(ordered[1])}</li>`);
      continue;
    }

    const quote = line.match(/^>\s+(.+)$/);
    if (quote) {
      closeParagraph();
      closeList();
      output.push(`<blockquote>${renderInlineMarkdown(quote[1])}</blockquote>`);
      continue;
    }

    closeList();
    paragraph.push(line);
  }

  if (inCodeBlock) closeCodeBlock();
  closeParagraph();
  closeList();
  return output.join('\n');
}

const latestRelease = await getLatestRelease();
const preferredAsset = latestRelease?.assets.find((asset) => /\.(exe|msi|msix|zip)$/i.test(asset.name));
const downloadUrl = preferredAsset?.browser_download_url ?? latestRelease?.html_url ?? `${releasesUrl}/latest`;
const releaseTitle = latestRelease?.name || latestRelease?.tag_name || 'Phiên bản mới nhất';
const releaseDate = latestRelease
  ? new Intl.DateTimeFormat('vi-VN', { day: '2-digit', month: 'long', year: 'numeric' }).format(new Date(latestRelease.published_at))
  : null;
const changelogHtml = latestRelease?.body?.trim() ? renderReleaseMarkdown(latestRelease.body) : '';
---

<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="VKey là bộ gõ tiếng Việt mã nguồn mở cho Windows, hỗ trợ Telex, VNI, cấu hình theo ứng dụng và xử lý phím gõ ngay trên máy." />
    <meta id="theme-color" name="theme-color" content="#ffffff" />
    <title>VKey - Bộ gõ tiếng Việt cho Windows</title>
    <link rel="icon" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script is:inline>
      (() => {
        let theme = 'light';
        try {
          const savedTheme = localStorage.getItem('vkey-theme');
          theme = savedTheme === 'light' || savedTheme === 'dark'
            ? savedTheme
            : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        } catch {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
        document.querySelector('#theme-color')?.setAttribute('content', theme === 'dark' ? '#0e1322' : '#ffffff');
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="VKey home">
        <img class="brand-mark" src="/logo.png" alt="VKey logo" width="36" height="36" />
        <span>VKey</span>
      </a>
      <nav class="nav" aria-label="Điều hướng chính">
        <a href="#changelog">Bản phát hành</a>
        <a href="#features">Tính năng</a>
        <a href="#install">Cài đặt</a>
        <a href="#faq">Câu hỏi</a>
        <a href={guideUrl}>Hướng dẫn</a>
      </nav>
      <div class="header-actions">
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Chuyển giao diện" title="Chuyển giao diện">
          <Moon class="theme-icon theme-icon-moon" size={19} aria-hidden="true" />
          <Sun class="theme-icon theme-icon-sun" size={19} aria-hidden="true" />
        </button>
        <a class="header-cta" href={downloadUrl}>Tải xuống</a>
      </div>
    </header>

    <main id="top">
      <section class="hero section-shell">
        <div class="hero-copy">
          <p class="eyebrow"><Sparkles size={16} /> Mã nguồn mở cho Windows</p>
          <h1>Bộ gõ tiếng Việt cho Windows.</h1>
          <p class="hero-lead">
            Hỗ trợ Telex, VNI, cấu hình theo ứng dụng và xử lý phím gõ ngay trên máy.
          </p>

          <div class="cta-row" aria-label="Download options">
            <a class="button button-primary" href={downloadUrl}>
              <Download size={20} /> Tải bản mới nhất
            </a>
            <a class="button button-secondary" href="#install">
              <Terminal size={18} /> Cài bằng winget
            </a>
          </div>

          <div class="command-card" aria-label="Winget install command">
            <Terminal size={18} />
            <code id="winget-hero">winget install {wingetStandardId}</code>
            <button class="copy-button" type="button" data-copy-target="winget-hero" aria-label="Sao chép lệnh winget">
              <Copy size={16} />
            </button>
          </div>

        </div>

        <div class="hero-visual" aria-label="VKey app preview">
          <div class="app-preview-stage">
            <div class="app-window">
              <div class="window-bar">
                <span></span><span></span><span></span>
              </div>
              <div class="window-body">
                <div class="status-pill"><Zap size={14} /> Nhớ chế độ theo ứng dụng</div>
                <h2>Gõ tiếng Việt theo cách bạn chọn</h2>
                <div class="typing-demo">
                  <span>tieengs Vieetj</span>
                  <ChevronRight size={18} />
                  <strong>tiếng Việt</strong>
                </div>
                <div class="settings-list">
                  <div><Keyboard size={18} /> Telex, VNI và kiểu gõ tùy chỉnh</div>
                  <div><Cpu size={18} /> Engine C++20, Rust tùy chọn</div>
                  <div><Settings2 size={18} /> Cấu hình theo từng ứng dụng</div>
                </div>
              </div>
            </div>
            <div class="preview-notes" aria-label="Điểm nổi bật của VKey">
              <div class="preview-note"><ShieldCheck size={18} /> Xử lý cục bộ, không ghi phím</div>
              <div class="preview-note"><Gamepad2 size={18} /> Cấu hình riêng cho game</div>
            </div>
          </div>
        </div>
      </section>

      <section class="product-facts section-shell" aria-label="Thông tin chính về VKey">
        <div class="trust-row">
          <span><CheckCircle2 size={16} /> Không thu thập hoặc gửi phím gõ</span>
          <span><CheckCircle2 size={16} /> Telex, VNI và kiểu gõ tùy chỉnh</span>
          <span><CheckCircle2 size={16} /> Chế độ game cấu hình theo ứng dụng</span>
          <span><CheckCircle2 size={16} /> Engine C++20, Rust nâng cao tùy chọn</span>
          <span><CheckCircle2 size={16} /> Hỗ trợ Hook và Windows TSF</span>
        </div>
      </section>

      <section id="changelog" class="section-shell changelog-section">
        <div class="section-heading">
          <p class="eyebrow"><FileText size={16} /> Bản phát hành</p>
          <h2>Thay đổi mới nhất</h2>
        </div>

        <article class="release-card">
          <div>
            <p class="release-meta">{releaseDate ?? 'Chưa lấy được release'}</p>
            <h3>{releaseTitle}</h3>
          </div>
          <a class="release-link" href={latestRelease?.html_url ?? releasesUrl} target="_blank" rel="noreferrer">
            Xem trên GitHub <Github size={18} />
          </a>

          {
            changelogHtml ? (
              <div class="changelog-content" set:html={changelogHtml}></div>
            ) : (
              <p class="empty-note">Chưa có nội dung changelog công khai. Khi GitHub Release có mô tả, phần này sẽ hiển thị tại đây.</p>
            )
          }
        </article>
      </section>

      <section id="features" class="section-shell">
        <div class="section-heading centered">
          <h2>Các chức năng chính</h2>
          <p>Telex, VNI, cấu hình theo ứng dụng hoặc website, macro, chuyển mã và hai cơ chế tích hợp với Windows.</p>
        </div>

        <div class="feature-grid">
          <article class="feature-card">
            <Cpu size={24} />
            <h3>Engine C++20 và Rust tùy chọn</h3>
            <p>Engine C++20 được tích hợp sẵn. Engine Rust cho kiểm tra chính tả nâng cao là tùy chọn và mặc định tắt.</p>
          </article>
          <article class="feature-card">
            <Keyboard size={24} />
            <h3>Telex, VNI và kiểu gõ tùy chỉnh</h3>
            <p>Hỗ trợ Telex, VNI, Simple Telex, chế độ kết hợp và các bảng mã Unicode, TCVN3, VNI Windows.</p>
          </article>
          <article class="feature-card">
            <RefreshCcw size={24} />
            <h3>Nhớ chế độ theo ứng dụng</h3>
            <p>Ghi nhớ trạng thái Việt hoặc Anh, cho phép đặt quy tắc riêng và tự tắt khi dùng bố cục bàn phím CJK.</p>
          </article>
          <article class="feature-card">
            <Gamepad2 size={24} />
            <h3>Chế độ Game (WASD)</h3>
            <p>Cho phép chọn cách gửi phím riêng cho từng game để giảm xung đột giữa Telex và các phím di chuyển.</p>
          </article>
          <article class="feature-card">
            <Zap size={24} />
            <h3>Macro và chuyển mã</h3>
            <p>Macro hỗ trợ nội dung dài và xuống dòng. Công cụ chuyển mã làm việc trên phần văn bản đang chọn.</p>
          </article>
          <article class="feature-card">
            <Layers size={24} />
            <h3>Xử lý cục bộ</h3>
            <p>VKey không thu thập, lưu trữ hoặc gửi phím gõ. Mã nguồn được công khai để người dùng kiểm tra.</p>
          </article>
        </div>

        <aside class="guide-callout" aria-label="VKey Browser thử nghiệm">
          <div class="guide-callout-copy">
            <Globe2 size={24} />
            <div>
              <h3>VKey Browser (thử nghiệm)</h3>
              <p>
                Giữ chế độ VKey mặc định hoặc áp dụng English, TSF theo từng website. Ví dụ: Google dùng V, VOZ dùng E và tự đổi khi chuyển tab.
              </p>
            </div>
          </div>
          <a class="guide-link" href="/guide#browser-extension">
            Cách cài extension <ChevronRight size={17} />
          </a>
        </aside>
      </section>

      <section id="install" class="section-shell install-section">
        <div class="section-heading">
          <h2>Cài đặt theo cách bạn muốn</h2>
          <p>Tải tệp ZIP từ GitHub Releases hoặc cài đặt bằng WinGet.</p>
        </div>

        <div class="install-grid">
          <article class="install-card highlighted">
            <Download size={24} />
            <h3>GitHub Release</h3>
            <p>Tải tệp ZIP từ GitHub, giải nén và chạy ứng dụng:</p>
            <ul class="edition-list">
              <li>
                <CheckCircle2 size={16} />
                <span><strong>Bản Tiêu chuẩn:</strong> Giao diện Sciter, tự đổi giao diện sáng hoặc tối theo Windows.</span>
              </li>
              <li>
                <CheckCircle2 size={16} />
                <span><strong>Bản Classic:</strong> Giao diện Win32 native, không nạp engine Rust. SignPath Foundation chỉ ký các tệp VKeyClassic.exe, VKeyTSF.dll và VKeyWatchdog.exe trong artifact Classic riêng.</span>
              </li>
            </ul>
            <div class="install-actions">
              <a href={downloadUrl}>Tải bản Tiêu chuẩn mới nhất <ChevronRight size={16} /></a>
              <a class="secondary" href={releasesUrl} target="_blank" rel="noreferrer">Xem tất cả bản tải (Classic...) <ChevronRight size={16} /></a>
            </div>
          </article>

          <article class="install-card">
            <Terminal size={24} />
            <h3>Cài đặt qua WinGet</h3>
            <p>Mở Terminal hoặc PowerShell và chạy một trong hai lệnh bên dưới:</p>
            <div class="install-commands">
              <div class="command-group">
                <span class="command-group-label">Bản Tiêu chuẩn (Sciter UI)</span>
                <div class="command-box">
                  <code id="winget-standard">winget install {wingetStandardId}</code>
                  <button class="copy-button" type="button" data-copy-target="winget-standard" aria-label="Sao chép lệnh winget bản Tiêu chuẩn">
                    <Copy size={16} />
                  </button>
                </div>
              </div>
              <div class="command-group">
                <span class="command-group-label">Bản Classic (Win32 Native)</span>
                <div class="command-box">
                  <code id="winget-classic">winget install {wingetClassicId}</code>
                  <button class="copy-button" type="button" data-copy-target="winget-classic" aria-label="Sao chép lệnh winget bản Classic">
                    <Copy size={16} />
                  </button>
                </div>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section id="faq" class="section-shell faq-section">
        <div class="section-heading centered">
          <h2>Câu hỏi thường gặp</h2>
          <p>Thông tin về dữ liệu phím gõ, các phiên bản và cách cấu hình VKey.</p>
        </div>

        <div class="faq-grid">
          <details open>
            <summary>VKey xử lý dữ liệu phím gõ như thế nào?</summary>
            <div class="faq-body">
              <ul>
                <li><strong>Xử lý cục bộ:</strong> Theo chính sách của dự án, VKey không thu thập, lưu trữ hoặc gửi phím gõ.</li>
                <li><strong>Mã nguồn công khai:</strong> Phần mã nguồn mở được phát hành trên GitHub theo GPL-3.0 để cộng đồng kiểm tra.</li>
                <li><strong>Xác minh bản tải:</strong> Dự án cung cấp Sigstore và build attestation cho các bản phát hành.</li>
              </ul>
            </div>
          </details>

          <details>
            <summary>Windows hoặc phần mềm diệt virus cảnh báo VKey, tôi nên làm gì?</summary>
            <div class="faq-body">
              <ul>
                <li><strong>Kiểm tra nguồn tải:</strong> Chỉ tải từ GitHub Releases chính thức và xác minh Sigstore attestation trước khi tạo ngoại lệ.</li>
                <li><strong>Cảnh báo theo hành vi:</strong> Bộ gõ cần đọc và gửi lại phím để đặt dấu nên có thể bị nhận diện nhầm. Trạng thái ký số tùy từng phiên bản.</li>
                <li><a href={antivirusGuideUrl} target="_blank" rel="noreferrer">Xem cách xác minh, khôi phục và xử lý cảnh báo</a>.</li>
              </ul>
            </div>
          </details>

          <details>
            <summary>VKey có mấy phiên bản? Khác nhau như thế nào?</summary>
            <div class="faq-body">
              <ul>
                <li><strong>Bản Tiêu chuẩn (Sciter UI):</strong> Tự đổi giao diện sáng hoặc tối theo Windows và có thể nạp engine Rust tùy chọn.</li>
                <li><strong>Bản Classic:</strong> Giao diện Win32 native. Bản phát hành chính thức không nạp engine Rust.</li>
              </ul>
            </div>
          </details>

          <details>
            <summary>SignPath Foundation áp dụng cho những tệp nào?</summary>
            <div class="faq-body">
              <ul>
                <li><strong>Phạm vi ký:</strong> Chỉ gồm <code>VKeyClassic.exe</code>, <code>VKeyTSF.dll</code> và <code>VKeyWatchdog.exe</code> được build từ mã nguồn GPL-3.0 công khai.</li>
                <li><strong>Cấu hình riêng:</strong> Artifact Classic được build với Rust engine bị compile-out hoàn toàn và không chứa hoặc nạp Sciter.</li>
                <li><strong>Ngoài phạm vi:</strong> VKeyApp, installer dùng Sciter, Rust engine và thành phần proprietary không được gửi Foundation ký. <code>VKeyBrowserHost.exe</code> là mã nguồn mở GPL-3.0 nhưng không nằm trong request ba tệp hiện tại.</li>
              </ul>
            </div>
          </details>

          <details>
            <summary>Engine Rust Nâng cao là gì và có bắt buộc dùng không?</summary>
            <div class="faq-body">
              <ul>
                <li><strong>Không bắt buộc:</strong> VKey mặc định dùng engine C++20 có sẵn cho các chức năng gõ tiếng Việt thông thường.</li>
                <li><strong>Tính năng mở rộng:</strong> Engine Rust bổ sung tự sửa một số lỗi đảo phím và nhận diện từ tiếng Anh. Tính năng này mặc định tắt.</li>
              </ul>
            </div>
